# infra/secrets/backup.secret.example
# Backup configuration — copy to backup.secret and fill values
# Generated automatically by: make secrets-setup

# =============================================================================
# OFFSITE BACKUP STORAGE (S3-compatible)
# =============================================================================
# This is the CROSS-PROVIDER copy. The deployed environment and its local backups
# both live on the same Hetzner account, so with this disabled an incident on that
# account loses them together. Leaving it off is a deliberate choice, not a default to
# inherit — the backup script now reports "degraded" rather than "success" when
# the offsite copy did not happen (#3669).
#
# Requires the aws CLI on the host:  apt-get install -y awscli

# ⚠️ Must be exactly "true" — anything else disables the offsite copy.
S3_BACKUP_ENABLED=false

S3_BACKUP_ACCESS_KEY=change_me
S3_BACKUP_SECRET_KEY=change_me
S3_BACKUP_BUCKET_NAME=meepleai-backups

# --- Choose ONE provider ----------------------------------------------------
#
# AWS S3:
#   S3_BACKUP_ENDPOINT=https://s3.eu-central-1.amazonaws.com
#   S3_BACKUP_REGION=eu-central-1        # ⚠️ REQUIRED — "auto" is rejected by AWS
#
# Cloudflare R2 (zero egress, cheaper to restore from):
#   S3_BACKUP_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#   S3_BACKUP_REGION=auto
#
S3_BACKUP_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
S3_BACKUP_REGION=auto

# IAM/token permissions: object read+write on the backup bucket only. The script
# also prunes old prefixes, so it needs DeleteObject and ListBucket there.

# --- Client-side encryption (REQUIRED for the offsite copy) -----------------
#
# age public key. Everything uploaded is encrypted with it first; the local copy
# stays plaintext so backup-restore-test.sh can keep running. Without this the
# upload is REFUSED rather than falling back to plaintext — S3 server-side
# encryption protects the disks, not the bucket's contents from whoever holds a
# key to it.
#
# Generate:  age-keygen -o backup-key.txt
#            → public line "age1..." goes here
#            → the PRIVATE key must NOT stay on the VPS (that would defeat the
#              point) and must NOT be lost (backups become unrecoverable).
#              Store it in the password manager, next to the DR runbook.
#
# Requires the age binary on the host:  apt-get install -y age
BACKUP_AGE_RECIPIENT=

# =============================================================================
# BACKUP POLICY
# =============================================================================

# Days to keep local + R2 backups before auto-deletion
BACKUP_RETENTION_DAYS=7

# =============================================================================
# NOTIFICATIONS  — not optional if the offsite copy is on
# =============================================================================
#
# backup.sh, backup-verify.sh and backup-restore-test.sh all report through the
# same channel. Two transports are tried in order:
#
#   1. webhook — BACKUP_WEBHOOK_URL, else SLACK_WEBHOOK_URL from
#      monitoring.secret. You do NOT need to set it twice.
#   2. email   — SMTP_* from email.secret, to BACKUP_ALERT_EMAIL_TO
#      (defaults to SMTP_FROM_EMAIL).
#
# Leave BOTH empty and every failure is silent. That is not hypothetical: this
# variable was empty on staging for the whole life of the offsite copy, so the
# "degraded" signal added by PR #3690 had nowhere to go, and the monthly restore
# test failed three times in a row without anyone hearing about it (#3669).
#
# backup-verify.sh checks daily that a channel exists AND is reachable: it probes
# the webhook with an empty body, which a live Slack hook rejects as 400 while a
# revoked one answers 404 — no message posted either way. The hook configured on
# staging turned out to be revoked, which is why the email transport exists.

# Webhook URL for backup success/degraded/failure notifications.
# Supports Slack, Discord, or any JSON-accepting endpoint.
# Format: {"text": "[status] MeepleAI backup on <host>: message"}
BACKUP_WEBHOOK_URL=

# Where the email fallback delivers. Defaults to SMTP_FROM_EMAIL from
# email.secret, so a host with working SMTP is never left with no destination.
BACKUP_ALERT_EMAIL_TO=
