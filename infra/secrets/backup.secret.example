# infra/secrets/backup.secret.example
# Backup configuration — copy to backup.secret and fill values
# Generated automatically by: make secrets-setup

# =============================================================================
# OFFSITE BACKUP STORAGE (S3-compatible)
# =============================================================================
# This is the CROSS-PROVIDER copy. Production and the local backups both live on
# the same Hetzner account, so with this disabled an incident on that account
# loses them together. Leaving it off is a deliberate choice, not a default to
# inherit — the backup script now reports "degraded" rather than "success" when
# the offsite copy did not happen (#3669).
#
# Requires the aws CLI on the host:  apt-get install -y awscli

# ⚠️ Must be exactly "true" — anything else disables the offsite copy.
S3_BACKUP_ENABLED=false

S3_BACKUP_ACCESS_KEY=change_me
S3_BACKUP_SECRET_KEY=change_me
S3_BACKUP_BUCKET_NAME=meepleai-backups

# --- Choose ONE provider ----------------------------------------------------
#
# AWS S3:
#   S3_BACKUP_ENDPOINT=https://s3.eu-central-1.amazonaws.com
#   S3_BACKUP_REGION=eu-central-1        # ⚠️ REQUIRED — "auto" is rejected by AWS
#
# Cloudflare R2 (zero egress, cheaper to restore from):
#   S3_BACKUP_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#   S3_BACKUP_REGION=auto
#
S3_BACKUP_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
S3_BACKUP_REGION=auto

# IAM/token permissions: object read+write on the backup bucket only. The script
# also prunes old prefixes, so it needs DeleteObject and ListBucket there.

# =============================================================================
# BACKUP POLICY
# =============================================================================

# Days to keep local + R2 backups before auto-deletion
BACKUP_RETENTION_DAYS=7

# =============================================================================
# NOTIFICATIONS (optional)
# =============================================================================

# Webhook URL for backup success/failure notifications
# Supports Slack, Discord, or any JSON-accepting endpoint
# Format: {"text": "[OK/FAIL] MeepleAI Backup: message"}
BACKUP_WEBHOOK_URL=
