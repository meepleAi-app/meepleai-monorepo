<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Enable security and code quality analyzers (matching Api.csproj) -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!--
      Suppress xUnit analyzer warnings for test project:
      - xUnit1000: Test classes must be public (using internal with InternalsVisibleTo)
      - xUnit1051: CancellationToken usage (best practice, not required for correctness)
      - xUnit2012: Assert.True for collections (FluentAssertions preferred)
      - xUnit2002: Assert.NotNull on value types (DateTime)
      - EF1002: SQL injection (test code uses parameterized table names safely)
      - CA1707: Remove underscores from member names (test naming convention)
      - CA1711: Rename type so that it does not end in 'Base' (test base classes)
      - CA2007: Do not directly await a Task (test fixture initialization)
      - CA2000: Dispose objects (test containers handle disposal)

      These are code style warnings, not bugs. Tests pass correctly.
      Tracked in: BGAI-083 - Phase 1A Bug Fixes
      - CS0060: Inconsistent accessibility (public test classes inherit from internal base)
    -->
    <NoWarn>$(NoWarn);xUnit1000;xUnit1051;xUnit2012;xUnit2002;EF1002;CA1707;CA1711;CA2007;CA2000;CS0060;MA0001;MA0002;MA0003;MA0004;MA0005;MA0006;MA0007;MA0048;MA0011;MA0051;MA0074;S101;S1450;S1481;S1501;S2234;S2325;S2925;S3626;S3981;S6608;S6562;S1172;S3878;S6966;S108;S1854;MA0132;MA0015;MA0158</NoWarn>
  </PropertyGroup>
  <!-- Specify Docnet runtime for Linux when running in CI -->
  <PropertyGroup Condition="'$(CI)' == 'true'">
    <DocnetRuntime>linux</DocnetRuntime>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="FluentAssertions" Version="8.8.0" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <!-- Mirror DEC-3d-1 (ADR-2026-06-09): Magick.NET-Q8-AnyCPU replaces SixLabors.ImageSharp.
         Test fixtures rely on the same image library used by production code. -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.15.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.11" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="Moq.Contrib.HttpClient" Version="1.4.0" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
    <PackageReference Include="Polly" Version="8.5.0" />
    <PackageReference Include="QuestPDF" Version="2025.12.3" />
    <PackageReference Include="ScottPlot" Version="5.1.57" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.TestCorrelator" Version="4.0.0" />
    <!-- Issue #3707 / GHSA-q939-rpr3-3284 (HIGH): Testcontainers <=4.13.0 tira
         transitive SSH.NET 2025.1.0 (path traversal in ScpClient.Download
         ricorsivo, vulnerabile <=2025.1.0). 4.14.0 è la prima release che
         dichiara SSH.NET >= 2026.0.0. Il path SSH è usato solo per Docker host
         remoto: la suite gira contro Docker locale, quindi il bump serve a
         tenere leggibile il gate "Dependency Vulnerabilities", non a chiudere
         un'esposizione reale. -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageReference Include="Testcontainers.Redis" Version="4.14.0" />
    <!-- Issue #2662 / GHSA-24c8-4792-22hx (HIGH): WireMock.Net tira transitive
         Scriban.Signed 7.0.6 (array.insert_at unbounded fill loop → OOM/DoS,
         vulnerabile <=7.1.0). Override alla versione patchata 7.2.0 per far
         passare il check CI "Dependency Vulnerabilities" (fail su HIGH/CRITICAL).
         Solo test project — Scriban non è nel path di produzione (Api pulito). -->
    <PackageReference Include="Scriban.Signed" Version="7.2.1" />
    <PackageReference Include="WireMock.Net" Version="2.5.0" />
    <PackageReference Include="xunit.abstractions" Version="2.0.3" />
    <PackageReference Include="xunit.v3" Version="3.2.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.11" />
    <!-- Force the SQLitePCLRaw native bundle to 3.x: the transitive 2.1.10 pulled by
         Microsoft.Data.Sqlite bundles a vulnerable SQLite (GHSA-2m69-gcr7-jv3q, HIGH,
         vulnerable <= 2.1.11, no 2.x patch). The 3.x bundle ships SQLite 3.50.x.
         Test-only dependency (in-memory SQLite for EndpointContractTests). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.11" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.msbuild" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <!-- Security and code quality analyzers (matching Api.csproj) -->
  <ItemGroup>
    <!-- Microsoft official .NET security and code quality analyzers -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.100">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- SonarAnalyzer for comprehensive security and code quality rules -->
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.16.1.129956">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Meziantou Analyzer for additional best practices and security checks -->
    <PackageReference Include="Meziantou.Analyzer" Version="2.0.257">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- GHSA-pggp-6c3x-2xmx: mirror Snappier override from Api.csproj for the
         test project. ProjectReference doesn't propagate package overrides. -->
    <PackageReference Include="Snappier" Version="1.3.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Api\Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Integration\DocumentProcessing\PrivatePdfUploadIntegrationTests.cs" />
  </ItemGroup>
  <!--
    MeepleDev: DevTools tests reference Api.DevTools.* types, which Api.csproj
    excludes from Release builds via <Compile Remove>. Mirror that exclusion
    here so the test project builds cleanly in Release as well.
  -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Compile Remove="DevTools\**\*.cs" />
    <Compile Remove="Integration\DevTools\**\*.cs" />
    <None Remove="DevTools\**\*.cs" />
    <None Remove="Integration\DevTools\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="runtimeconfig.template.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- SP1 de-risk gate: real captured Unstructured service responses used as test fixtures -->
    <None Update="TestData\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>