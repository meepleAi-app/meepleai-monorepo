{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Authentication": {
    "SessionCookie": {
      "Secure": true,
      "SameSite": "None",
      "HttpOnly": true
    },
    "SessionManagement": {
      "InactivityTimeoutDays": 30,
      "AutoRevocationIntervalHours": 1
    },
    "OAuth": {
      "CallbackBaseUrl": "${OAUTH_CALLBACK_BASE_URL}"
    }
  },
  "HybridCache": {
    "EnableL2Cache": true,
    "MaximumPayloadBytes": 10485760,
    "DefaultExpiration": "24:00:00",
    "L2Timeout": "00:00:02",
    "MaxConcurrentFactories": 1,
    "EnableTags": true,
    "MaxTagsPerEntry": 10
  },
  "Staging": {
    "ContactEmail": "badsworm@gmail.com"
  },
  "DomainEventOutbox": {
    "Comment": "Issue #1535 Phase A — explicit Hybrid mode for staging soak. Validates the 24h DoD-9 latency check (p95 < 10s) before the production cutover flips this to OutboxOnly. Same explicit-override rationale as appsettings.Production.json.",
    "Mode": "Hybrid"
  }
}
